{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aixin.io/schemas/sip-report.schema.json",
  "title": "AiXin SIP Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["sip_id", "schema_ok", "rules_passed", "rules_total", "risk", "requires_approval", "reasons", "intent"],
  "properties": {
    "sip_id":            { "type": "string", "pattern": "^sip_[0-9a-f]{6,}$" },
    "schema_ok":         { "type": "boolean" },
    "rules_passed":      { "type": "integer", "minimum": 0 },
    "rules_total":       { "type": "integer", "minimum": 1 },
    "risk":              { "type": "string", "enum": ["low", "medium", "high"] },
    "requires_approval": { "type": "boolean" },
    "reasons":           { "type": "array", "items": { "type": "string" } },
    "intent":            { "$ref": "intent.schema.json" }
  }
}
