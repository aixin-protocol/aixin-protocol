{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aixin.io/schemas/outcome-contract.schema.json",
  "title": "AiXin Outcome Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "success_metrics", "principal", "created_at"],
  "properties": {
    "objective":    { "type": "string", "minLength": 1 },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "op", "value"],
        "properties": {
          "name":  { "type": "string" },
          "op":    { "type": "string", "enum": ["<=", ">=", "==", "in"] },
          "value": {}
        }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "principal":    { "type": "string" },
    "created_at":   { "type": "string", "format": "date-time" }
  }
}
