{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aixin.io/schemas/bounded-loop.schema.json",
  "title": "AiXin TOP Bounded Loop",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_steps", "max_wallclock_seconds"],
  "properties": {
    "max_steps":             { "type": "integer", "minimum": 1 },
    "max_spend":             { "type": "number",  "exclusiveMinimum": 0 },
    "max_wallclock_seconds": { "type": "integer", "minimum": 1 },
    "max_external_calls":    { "type": "integer", "minimum": 0 }
  }
}
