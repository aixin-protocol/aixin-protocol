{
  "name": "@aixin-protocol/validator-server",
  "version": "1.0.0-rc.1",
  "description": "Hosted HTTP reference validator for the AiXin Protocol (SIP + TOP). Accepts intents, validates against normative schemas, and returns Ed25519-signed receipts.",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "aixin-validator-server": "./src/server.mjs"
  },
  "files": ["src", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/server.test.mjs"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/aixin-protocol/aixin-protocol.git", "directory": "server" },
  "license": "Apache-2.0"
}
