{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aixin.io/schemas/aixin-manifest.schema.json",
  "title": "aixin.json Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "agent", "sip", "top", "registries"],
  "properties": {
    "protocol": { "type": "string", "const": "aixin/1.0" },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "domain"],
      "properties": {
        "name":   { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
      }
    },
    "sip": {
      "type": "object", "additionalProperties": false,
      "required": ["action_set"],
      "properties": {
        "action_set": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "amount_cap": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "top": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome_contract", "bounds", "revocation_key"],
      "properties": {
        "outcome_contract": { "type": "string" },
        "bounds":           { "$ref": "bounded-loop.schema.json" },
        "revocation_key":   { "type": "string", "minLength": 1 }
      }
    },
    "registries": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "reputation", "validation", "anchor"],
      "properties": {
        "identity":   { "$ref": "#/$defs/registryRef" },
        "reputation": { "$ref": "#/$defs/registryRef" },
        "validation": { "$ref": "#/$defs/registryRef" },
        "anchor":     { "$ref": "#/$defs/registryRef" }
      }
    }
  },
  "$defs": {
    "registryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["chain", "address"],
      "properties": {
        "chain":   { "type": "string" },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      }
    }
  }
}
